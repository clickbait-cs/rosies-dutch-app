  "grammar": [
    {
      "title": "Telling the time",
      "titleVi": "Cách nói giờ",
      "en": "3:00 = drie uur\n3:15 = kwart over drie\n3:30 = half vier (!) — Dutch says \"half to four\", not \"half past three\".\n3:45 = kwart voor vier\n3:10 = tien over drie, 3:50 = tien voor vier",
      "vi": "3:00 = drie uur (ba giờ)\n3:15 = kwart over drie (ba giờ mười lăm)\n3:30 = half vier (!) — người Hà Lan nói \"nửa tiếng nữa đến bốn giờ\", tức là 3 giờ rưỡi. Rất dễ nhầm!\n3:45 = kwart voor vier (bốn giờ kém mười lăm)\n3:10 = tien over drie, 3:50 = tien voor vier (bốn giờ kém mười)",
      "examples": [
        {
          "nl": "Het is half acht.",
          "en": "It is half past seven (7:30)."
        },
        {
          "nl": "Het is kwart voor negen.",
          "en": "It is a quarter to nine."
        }
      ]
    },
    {
      "title": "Verb in 2nd place: Vandaag werk ik",
      "titleVi": "Động từ ở vị trí thứ 2: Vandaag werk ik",
      "en": "When a sentence starts with a time word, the subject comes after the verb: Ik werk vandaag → Vandaag werk ik.",
      "vi": "Khi câu bắt đầu bằng từ chỉ thời gian, chủ ngữ đứng sau động từ: Ik werk vandaag → Vandaag werk ik.",
      "examples": [
        {
          "nl": "Morgen ga ik naar Amsterdam.",
          "en": "Tomorrow I'm going to Amsterdam."
        }
      ],
      "tip": "inversion"
    },
    {
      "title": "Separable verbs",
      "titleVi": "Động từ tách được",
      "en": "opstaan → Ik sta om zeven uur op. The small front part goes to the end.",
      "vi": "opstaan → Ik sta om zeven uur op. Phần đầu nhỏ chuyển xuống cuối câu.",
      "examples": [
        {
          "nl": "Hij staat vroeg op.",
          "en": "He gets up early."
        }
      ],
      "tip": "separable"
    }
  ],
